# Supabase Storage (product images). Empty locally, which makes uploads fall
# back to MEDIA_ROOT (./media) instead of a bucket -- see
# common/storage/images.py. Real values live in .env / the Render dashboard.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images
