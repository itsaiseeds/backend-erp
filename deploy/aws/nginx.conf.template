# Host nginx site for the EC2 deploy. bootstrap.sh installs it as
# /etc/nginx/conf.d/saiseeds.conf with __HOST__ replaced by the Elastic IP
# (or a domain later). The certificate comes from certbot's webroot flow and
# lives under the fixed cert name "saiseeds", whichever kind of host it covers.

# Drop requests for any other Host (scanners, stray names) before they reach
# Django, where they would only raise DisallowedHost noise in GlitchTip.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;

    # Let's Encrypt renewals (every few days for an IP certificate) come in
    # here, so port 80 must stay open in the security group.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __HOST__;

    ssl_certificate     /etc/letsencrypt/live/saiseeds/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/saiseeds/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # nginx defaults to 1M, which rejects product image uploads.
    client_max_body_size 20M;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Django trusts this only with NUM_PROXIES=1 (throttling) and
        # SECURE_PROXY_SSL_HEADER=True (https detection).
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
