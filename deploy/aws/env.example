# Template for /opt/saiseeds/.env on the EC2 host (chmod 600, never committed).
# Same variables as the Render dashboard, plus the proxy settings nginx needs.
# Replace every <...> value.

DEBUG=False
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<long-random-string>
# In-process remote code execution: must stay off in production.
ENABLE_EXECUTE_CODE=0

ALLOWED_HOSTS=<elastic-ip>
CSRF_TRUSTED_ORIGINS=https://<elastic-ip>,https://sales-saiseeds.web.app
CORS_ALLOWED_ORIGINS=https://sales-saiseeds.web.app

# Behind host nginx: trust its X-Forwarded-Proto / X-Forwarded-For.
SECURE_PROXY_SSL_HEADER=True
SECURE_SSL_REDIRECT=True
NUM_PROXIES=1
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Keep 0 on a raw IP; set 31536000 once a domain is live and stable.
SECURE_HSTS_SECONDS=0

GUNICORN_WORKERS=2
GUNICORN_THREADS=4

POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=<neon-password>
POSTGRES_HOST=<neon-pooler-host>
POSTGRES_PORT=5432

DJANGO_SUPERUSER_USERNAME=<phone>
DJANGO_SUPERUSER_EMAIL=<email>
DJANGO_SUPERUSER_NAME=<name>
DJANGO_SUPERUSER_PASSWORD=<password>

SUPABASE_URL=<https://project.supabase.co>
SUPABASE_SECRET_KEY=<supabase-secret-key>
SUPABASE_STORAGE_BUCKET=product-images

FCM_PROJECT_ID=sales-saiseeds
FCM_ANDROID_CHANNEL_ID=order_updates
FCM_SERVICE_ACCOUNT_JSON='<service-account-json-on-one-line>'

SENTRY_DSN=<glitchtip-dsn>
SENTRY_ENV=production-aws
