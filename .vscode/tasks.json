        {
            "label": "typecheck",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/run.sh",
                "typecheck"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "integrationTestNode",
            "type": "promptString",
            "description": "Pytest node id to run in the container, for example:\n    tests/integration/test_auth_flow.py::AuthFlowTest::test_generate_otp_returns_200\nKeep the default to run the whole integration suite.",
            "default": "tests/integration"
        }
    ]
}