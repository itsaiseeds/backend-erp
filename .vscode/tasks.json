        },
        {
            "label": "lint",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/run.sh",
                "lint"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
