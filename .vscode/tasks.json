            "label": "test-integration: all tests",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/run.sh",
                "test-integration"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "test-integration: pick a test",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/run.sh",
                "test-integration",
                "${input:integrationTestNode}"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "options": {
                "cwd": "${workspaceFolder}"
